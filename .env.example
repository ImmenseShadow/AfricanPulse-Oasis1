# No API keys or secrets are needed. These are optional and are read from the
# process environment (the app does not load .env files). In PowerShell:
#   $env:APOASIS_PORT = "5050"
#
# Database location. Default on Windows: %LOCALAPPDATA%\AfricanPulseOasis\africanpulse.db
APOASIS_DB_PATH=
# Address the website listens on. Keep 127.0.0.1 so only this computer can open it.
APOASIS_HOST=127.0.0.1
APOASIS_PORT=5000
# Session signing key. Leave empty and one is generated and kept beside the database.
APOASIS_SECRET_KEY=
# Set to 1 only for local testing against feeds on localhost or a private network.
APOASIS_ALLOW_PRIVATE_FEEDS=
